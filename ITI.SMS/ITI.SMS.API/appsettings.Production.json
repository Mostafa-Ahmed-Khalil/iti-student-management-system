{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-prod-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=PRODUCTION_SQL_SERVER;Database=ITI_SMS_Prod_Db;User Id=SA;Password=YOUR_PRODUCTION_PASSWORD;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "PRODUCTION_SUPER_SECRET_KEY_PLACEHOLDER_AT_LEAST_32_BYTES_LONG",
    "Issuer": "ITI.SMS.API",
    "Audience": "ITI.SMS.Frontend"
  },
  "AllowedHosts": "*"
}
